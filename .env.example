# Database (packages/db)
# Supabase project: EU region (Frankfurt / ap-southeast-1), GDPR compliant
# Get these from: Supabase Dashboard → Project Settings → Database → Connection string
# DATABASE_URL uses the connection pooler (port 6543, pgbouncer mode)
# DIRECT_URL uses direct connection (port 5432) — required for migrations/db:push
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxxx:password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Supabase (apps/web, apps/company, apps/admin)
# Auth: email OTP / magic link — enable in Supabase Auth settings
# After db:push, apply RLS policies from packages/db/prisma/rls.sql via SQL editor
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_COMPANY_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3003

# Stripe (apps/web, apps/company)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Resend (packages/email)
RESEND_API_KEY=re_xxx

# Travel Advantage (apps/web — /dashboard/travel)
TRAVEL_ADVANTAGE_URL=https://www.traveladvantage.it

# Multi-currency (TIPA-98) — Stripe Price IDs per country/level
# Create these in Stripe Dashboard → Products → Add Price (one-time, no trial)
# Italy — EUR
STRIPE_PRICE_IT_WHITE=price_xxx
STRIPE_PRICE_IT_GOLD=price_xxx
STRIPE_PRICE_IT_PLATINUM=price_xxx
# United Kingdom — GBP
STRIPE_PRICE_GB_WHITE=price_xxx
STRIPE_PRICE_GB_GOLD=price_xxx
STRIPE_PRICE_GB_PLATINUM=price_xxx
# Switzerland — CHF
STRIPE_PRICE_CH_WHITE=price_xxx
STRIPE_PRICE_CH_GOLD=price_xxx
STRIPE_PRICE_CH_PLATINUM=price_xxx

# B2C Stripe webhook secret (apps/web) — falls back to STRIPE_WEBHOOK_SECRET if unset
STRIPE_B2C_WEBHOOK_SECRET=whsec_xxx

# Base URL for Stripe redirect URLs (must match Vercel/production URL)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
