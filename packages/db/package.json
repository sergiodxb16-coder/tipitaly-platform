{
  "name": "@tip-italy/db",
  "version": "0.1.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./auth": {
      "types": "./src/auth.ts",
      "default": "./src/auth.ts"
    },
    "./cards": {
      "types": "./src/cards.ts",
      "default": "./src/cards.ts"
    },
    "./coupons": {
      "types": "./src/coupons.ts",
      "default": "./src/coupons.ts"
    },
    "./travel": {
      "types": "./src/travel.ts",
      "default": "./src/travel.ts"
    }
  },
  "scripts": {
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "prisma": "^5.22.0",
    "typescript": "^5.7.2"
  }
}
