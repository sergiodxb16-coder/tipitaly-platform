generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

// WHITE < GOLD < PLATINUM (cumulative benefits; compare by ordinal in app code)
enum CardLevel {
  WHITE
  GOLD
  PLATINUM
}

enum CardStatus {
  INACTIVE
  ACTIVE
  EXPIRED
}

enum PartnerCategory {
  RISTORANTE
  HOTEL
  BENESSERE
  SPORT
  CULTURA
  SHOPPING
  SERVIZI
  MODA
  VIAGGI
  INTRATTENIMENTO
  ALTRO
}

enum AssignmentSource {
  B2B_BATCH    // card assigned from a company batch
  B2C_PURCHASE // card purchased directly by the cardholder
}

// ─── B2C Identity ────────────────────────────────────────────────────────────

// End-user who holds a card; linked to Supabase Auth
model Cardholder {
  id          String   @id @default(cuid())
  supabaseUid String   @unique
  email       String   @unique
  nome        String
  cognome     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cardAssignments   CardAssignment[]
  couponRedemptions CouponRedemption[]
  travelBookings    TravelBooking[]
  purchases         CardPurchase[]
  partnerRatings    PartnerRating[]
}

// ─── B2B Company ─────────────────────────────────────────────────────────────

// Corporate client that purchases card batches for their employees
model Company {
  id             String   @id @default(cuid())
  ragioneSociale String
  pIva           String   @unique
  emailReferente String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cardBatches CardBatch[]
}

// ─── Card Inventory ──────────────────────────────────────────────────────────

model Card {
  id                 String     @id @default(cuid())
  serialNumber       String     @unique
  level              CardLevel  @default(WHITE)
  status             CardStatus @default(INACTIVE)
  activationDeadline DateTime?
  activatedAt        DateTime?
  expiresAt          DateTime?
  cardBatchId        String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  cardBatch  CardBatch?      @relation(fields: [cardBatchId], references: [id])
  assignment CardAssignment?
  purchase   CardPurchase?
}

// Batch of cards purchased by a Company (B2B)
model CardBatch {
  id        String   @id @default(cuid())
  batchCode String   @unique
  quantity  Int
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company          @relation(fields: [companyId], references: [id])
  cards       Card[]
  assignments CardAssignment[]
}

// Links a Card to a Cardholder; one active assignment per card
model CardAssignment {
  id           String           @id @default(cuid())
  cardId       String           @unique
  cardholderId String
  cardBatchId  String?
  source       AssignmentSource
  assignedAt   DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  card       Card       @relation(fields: [cardId], references: [id])
  cardholder Cardholder @relation(fields: [cardholderId], references: [id])
  cardBatch  CardBatch? @relation(fields: [cardBatchId], references: [id])
}

// ─── Partners & Coupons ──────────────────────────────────────────────────────

model Partner {
  id                String          @id @default(cuid())
  nome              String
  slug              String?         @unique
  logoUrl           String?
  categoria         PartnerCategory
  sitoWeb           String?
  descrizione       String?
  descrizioneEstesa String?
  indirizzo         String?
  citta             String?
  cap               String?
  telefono          String?
  emailContatto     String?
  orari             Json?
  latitudine        Float?
  longitudine       Float?
  isFeatured        Boolean         @default(false)
  featuredOrder     Int?
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  coupons Coupon[]
  photos  PartnerPhoto[]
  ratings PartnerRating[]
}

model PartnerPhoto {
  id        String   @id @default(cuid())
  partnerId String
  url       String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
}

model PartnerRating {
  id           String     @id @default(cuid())
  partnerId    String
  cardholderId String
  stelle       Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  partner    Partner    @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  cardholder Cardholder @relation(fields: [cardholderId], references: [id])

  @@unique([partnerId, cardholderId])
}

model Coupon {
  id             String          @id @default(cuid())
  partnerId      String
  categoria      PartnerCategory
  descrizione    String
  /// Percentage discount, e.g. 15.00 = 15%
  sconto         Decimal         @db.Decimal(5, 2)
  scadenza       DateTime?
  codiceQr       String?         @unique
  maxRedemptions Int?
  minCardLevel   CardLevel       @default(WHITE)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  partner     Partner            @relation(fields: [partnerId], references: [id])
  redemptions CouponRedemption[]
}

// Tracks each coupon use by a cardholder
model CouponRedemption {
  id           String     @id @default(cuid())
  couponId     String
  cardholderId String
  redeemedAt   DateTime   @default(now())

  coupon     Coupon     @relation(fields: [couponId], references: [id])
  cardholder Cardholder @relation(fields: [cardholderId], references: [id])
}

// ─── B2C Purchases & Multi-currency ──────────────────────────────────────────

// Supported market countries with their native currency
enum SupportedCountry {
  IT // Italy — EUR
  GB // United Kingdom — GBP
  CH // Switzerland — CHF
}

enum SupportedCurrency {
  EUR
  GBP
  CHF
}

// Stripe Price IDs per card level per country
model CountryPricing {
  id            String          @id @default(cuid())
  cardLevel     CardLevel
  country       SupportedCountry
  currency      SupportedCurrency
  priceAmount   Int             // in minor units (e.g. 2900 = £29.00)
  stripePriceId String          // Stripe Price ID for this market
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([cardLevel, country])
}

// Records each B2C purchase with country, currency, and tax breakdown
model CardPurchase {
  id              String           @id @default(cuid())
  stripeSessionId String           @unique
  cardId          String?          @unique // set after card is created
  cardholderId    String?          // set after cardholder upsert
  cardLevel       CardLevel
  country         SupportedCountry @default(IT)
  currency        SupportedCurrency @default(EUR)
  amountTotal     Int              // gross in minor units (incl. tax)
  amountSubtotal  Int              // net in minor units (excl. tax)
  taxAmount       Int              @default(0)
  taxRate         Float?           // e.g. 0.22
  stripeLocale    String?          // e.g. "it", "en-GB", "de"
  createdAt       DateTime         @default(now())

  card        Card?        @relation(fields: [cardId], references: [id])
  cardholder  Cardholder?  @relation(fields: [cardholderId], references: [id])
}

// ─── Travel ──────────────────────────────────────────────────────────────────

model TravelOffer {
  id                 String    @id @default(cuid())
  titolo             String
  destinazione       String
  /// Percentage discount via Travel Advantage partnership
  scontoPercent      Decimal   @db.Decimal(5, 2)
  travelAdvantageUrl String?
  scadenza           DateTime?
  minCardLevel       CardLevel @default(WHITE)
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  bookings TravelBooking[]
}

// Records a cardholder's use of a travel offer
model TravelBooking {
  id            String   @id @default(cuid())
  travelOfferId String
  cardholderId  String
  notes         String?
  bookedAt      DateTime @default(now())

  travelOffer TravelOffer @relation(fields: [travelOfferId], references: [id])
  cardholder  Cardholder  @relation(fields: [cardholderId], references: [id])
}
